# Database
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/your_db_name
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=changeme

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Payment / Supplier (if used)
PAYMENT_GATEWAY=mock
PAYMENT_PROVIDER_API_KEY=your_api_key_here
SUPPLIER_API_KEY=your_api_key_here
SUPPLIER_CLIENT=mock
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_MOCK_FAIL=false
FULFILLMENT_WORKER_ENABLED=true
FULFILLMENT_WORKER_BATCH_SIZE=50
FULFILLMENT_WORKER_FIXED_DELAY=PT30S
FULFILLMENT_WORKER_INITIAL_DELAY=PT30S
# Set PAYMENT_GATEWAY=aba to use the PayWay sandbox configuration below.
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_MERCHANT_ID=your_new_sandbox_merchant_id
ABA_PAYWAY_API_KEY=your_new_sandbox_api_key
ABA_PAYWAY_CREATE_PATH=/api/payment-gateway/v1/payments/generate-qr
ABA_PAYWAY_STATUS_PATH=/api/payment-gateway/v1/payments/check-transaction-2
ABA_PAYWAY_PURCHASE_PATH=/api/payment-gateway/v1/payments/purchase
ABA_PAYWAY_PAYMENT_OPTION=abapay_khqr
ABA_PAYWAY_QR_IMAGE_TEMPLATE=template3_color
ABA_PAYWAY_LIFETIME_MINUTES=30
ABA_PAYWAY_CALLBACK_URL=https://your-test-domain.example/api/v1/payments/aba/callback
# Optional callback HMAC secret (when set, callbacks must sign the raw payload)
ABA_PAYWAY_CALLBACK_SECRET=
# Per-payment reconciliation cooldown
PAYMENT_RECONCILE_COOLDOWN=PT30S

# Scheduled ABA payment reconciliation
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_BATCH_SIZE=50
PAYMENT_RECONCILIATION_FIXED_DELAY=PT1M
PAYMENT_RECONCILIATION_INITIAL_DELAY=PT30S
PAYMENT_RECONCILIATION_MIN_AGE=PT1M
