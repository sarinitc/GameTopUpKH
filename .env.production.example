# Production environment template for docker-compose.prod.yaml.
#
# Copy to a file OUTSIDE this repository (for example /etc/gametopup/production.env
# on the host) and pass it explicitly:
#
#   docker compose --env-file /etc/gametopup/production.env \
#     -f docker-compose.prod.yaml up -d --build
#
# This file itself contains no real values and is safe to commit.
# Never point Compose at the development .env: it holds different values.

# ---- Database --------------------------------------------------------------
POSTGRES_DB=gametopup_db
POSTGRES_USER=gametopup_app
# REQUIRED. Generate on the server, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=
DB_POOL_SIZE=10

# ---- Application -----------------------------------------------------------
# REQUIRED. At least 32 characters. Rotating it signs out every existing session.
# Generate on the server, e.g.: openssl rand -base64 64
JWT_SECRET=
# REQUIRED. Public URL of the storefront used in password-reset links.
APP_PASSWORD_RESET_FRONTEND_BASE_URL=https://shop.example.com

# Host port the API is published on. Bound to 127.0.0.1 only; the reverse proxy
# forwards to it.
APP_HOST_PORT=8082
APP_IMAGE_TAG=latest

# ---- Commerce --------------------------------------------------------------
# Leave the mock gateway and mock supplier until ABA PayWay and an authorized
# supplier contract are in place. Live payments and the automatic fulfillment
# worker are disabled in docker-compose.prod.yaml and application-prod.yml.
PAYMENT_GATEWAY=mock
SUPPLIER_CLIENT=mock
FULFILLMENT_WORKER_ENABLED=false
PAYMENT_RECONCILIATION_ENABLED=false

# Only used when PAYMENT_GATEWAY=aba. Sandbox values must never be treated as live.
# ABA_PAYWAY_ENVIRONMENT=sandbox
# ABA_PAYWAY_MERCHANT_ID=
# ABA_PAYWAY_API_KEY=
# ABA_PAYWAY_CALLBACK_URL=https://shop.example.com/api/v1/payments/aba/callback
# ABA_PAYWAY_CALLBACK_SECRET=

# Browser origins allowed to call /api/**. Exact, comma-separated, no wildcards
# and no paths; anything else is rejected at startup. Leave empty to block all
# cross-origin browser access (curl/server-to-server calls still work).
# APP_CORS_ALLOWED_ORIGINS=https://gametopup-kh.vercel.app

# ---- Render / other PaaS (names differ from Compose) ------------------------
# Render does not use POSTGRES_*; it needs the Spring names directly. See
# docs/deployment/render.md for the full table.
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-user>
# SPRING_DATASOURCE_PASSWORD=<neon-password>
# DB_POOL_SIZE=5
# DB_POOL_MIN_IDLE=2
# APP_PASSWORD_RESET_FRONTEND_BASE_URL=https://your-app.vercel.app
# APP_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# PORT is injected by the platform; do not set it.
